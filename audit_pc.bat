@echo off
setlocal
echo ====================================================
echo  CyberSage - Standalone Local Windows Security Audit
echo  Read-Only Host Audit ^& JSON Report Generator
echo ====================================================
echo.
echo Auditing Windows Firewall, Defender, UAC, SMBv1, and System Policies...

set "OUT_FILE=%USERPROFILE%\Desktop\audit_report.json"

powershell -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference = 'SilentlyContinue'; $f = [System.Collections.Generic.List[object]]::new(); function addF($n,$c,$s,$d,$sev){ $f.Add(@{name=$n;category=$c;status=$s;details=$d;severity=$sev;checked_at=(Get-Date).ToUniversalTime().ToString('o')}) }; $fw = Get-NetFirewallProfile; if(($fw | Where-Object { $_.Enabled -ne $true }).Count -eq 0){ addF 'Windows Firewall Profiles' 'Core System Defenses' 'SAFE' 'All firewall profiles are enabled.' 'Low' } else { addF 'Windows Firewall Profiles' 'Core System Defenses' 'WARNING' 'One or more firewall profiles are disabled.' 'High' }; $def = Get-MpComputerStatus; if($def.RealTimeProtectionEnabled){ addF 'Microsoft Defender Real-Time Protection' 'Core System Defenses' 'SAFE' 'Real-time protection is active.' 'Low' } else { addF 'Microsoft Defender Real-Time Protection' 'Core System Defenses' 'WARNING' 'Real-time protection is disabled.' 'High' }; if($def.AntivirusSignatureAge -le 7){ addF 'Antivirus Threat Definitions' 'Core System Defenses' 'SAFE' ('Signatures updated ' + $def.AntivirusSignatureAge + ' days ago.') 'Low' } else { addF 'Antivirus Threat Definitions' 'Core System Defenses' 'WARNING' ('Signatures are ' + $def.AntivirusSignatureAge + ' days old.') 'Medium' }; $wu = Get-Service wuauserv; if($wu.Status -eq 'Running'){ addF 'Windows Update Service' 'Core System Defenses' 'SAFE' 'wuauserv is running.' 'Low' } else { addF 'Windows Update Service' 'Core System Defenses' 'WARNING' 'wuauserv is not running.' 'Medium' }; $uac = (Get-ItemProperty HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System).EnableLUA; if($uac -eq 1){ addF 'User Account Control (UAC)' 'Core System Defenses' 'SAFE' 'EnableLUA is active.' 'Low' } else { addF 'User Account Control (UAC)' 'Core System Defenses' 'WARNING' 'UAC EnableLUA is disabled.' 'High' }; $g = (Get-LocalUser -Name Guest -ErrorAction SilentlyContinue).Enabled; if($g -eq $false){ addF 'Guest Account Hardening' 'Core System Defenses' 'SAFE' 'Guest account is disabled.' 'Low' } else { addF 'Guest Account Hardening' 'Core System Defenses' 'WARNING' 'Guest account is enabled.' 'Medium' }; $smb = (Get-SmbServerConfiguration).EnableSMB1Protocol; if($smb -eq $false){ addF 'SMBv1 Legacy Protocol Exposure' 'Exploit Surface & Legacy Protocols' 'SAFE' 'SMBv1 protocol is disabled.' 'Low' } else { addF 'SMBv1 Legacy Protocol Exposure' 'Exploit Surface & Legacy Protocols' 'WARNING' 'SMBv1 protocol is enabled (WannaCry vulnerability).' 'High' }; $rdp = (Get-ItemProperty 'HKLM:\System\CurrentControlSet\Control\Terminal Server').fDenyTSConnections; $nla = (Get-ItemProperty 'HKLM:\System\CurrentControlSet\Control\Terminal Server\WinStations\RDP-Tcp').UserAuthentication; if($rdp -eq 1 -or $nla -eq 1){ addF 'Remote Desktop (RDP) & Network Level Authentication' 'Exploit Surface & Legacy Protocols' 'SAFE' 'RDP is disabled or requires NLA.' 'Low' } else { addF 'Remote Desktop (RDP) & Network Level Authentication' 'Exploit Surface & Legacy Protocols' 'WARNING' 'RDP is enabled without NLA.' 'High' }; $pua = (Get-MpPreference).PUAProtection; if($pua -eq 1){ addF 'Microsoft Defender PUA Protection' 'Ransomware & Malware Hardening' 'SAFE' 'PUA protection is enabled.' 'Low' } else { addF 'Microsoft Defender PUA Protection' 'Ransomware & Malware Hardening' 'WARNING' 'PUA protection is disabled.' 'Low' }; $cfa = (Get-MpPreference).EnableControlledFolderAccess; if($cfa -eq 1){ addF 'Microsoft Defender Controlled Folder Access (Ransomware Guard)' 'Ransomware & Malware Hardening' 'SAFE' 'Controlled Folder Access enabled.' 'Low' } else { addF 'Microsoft Defender Controlled Folder Access (Ransomware Guard)' 'Ransomware & Malware Hardening' 'WARNING' 'Controlled Folder Access disabled.' 'Medium' }; $log = (Get-ItemProperty HKLM:\SOFTWARE\Policies\Microsoft\Windows\PowerShell\ScriptBlockLogging).EnableScriptBlockLogging; if($log -eq 1){ addF 'PowerShell Script Block Logging (Event ID 4104)' 'Ransomware & Malware Hardening' 'SAFE' 'Script block logging is enabled.' 'Low' } else { addF 'PowerShell Script Block Logging (Event ID 4104)' 'Ransomware & Malware Hardening' 'WARNING' 'Script block logging is disabled.' 'Medium' }; $res = (Get-ItemProperty HKLM:\SYSTEM\CurrentControlSet\Control\Lsa).RestrictAnonymous; if($res -eq 1){ addF 'Anonymous SAM & Share Enumeration (RestrictAnonymous)' 'Exploit Surface & Legacy Protocols' 'SAFE' 'RestrictAnonymous is enabled.' 'Low' } else { addF 'Anonymous SAM & Share Enumeration (RestrictAnonymous)' 'Exploit Surface & Legacy Protocols' 'WARNING' 'Anonymous enumeration allowed.' 'Medium' }; $safe = ($f | Where-Object { $_.status -eq 'SAFE' }).Count; $warn = ($f | Where-Object { $_.status -eq 'WARNING' }).Count; $high = ($f | Where-Object { $_.status -eq 'WARNING' -and $_.severity -eq 'High' }).Count; $tot = $f.Count; $pct = [math]::Round(($safe / $tot) * 100); $rep = @{ results=$f; total_checks=$tot; safe_count=$safe; warning_count=$warn; high_severity_count=$high; unknown_count=0; evaluated_count=$tot; hygiene_percentage=$pct; scan_mode='deep'; scan_mode_label='Real Host Security Audit (Uploaded from Local PC)'; scanned_at=(Get-Date).ToUniversalTime().ToString('yyyy-MM-dd HH:mm:ss UTC'); coverage_note=($safe.ToString() + ' of ' + $tot.ToString() + ' passed.'); is_simulated=$false; environment_label='Local Physical Windows PC'; disclaimer='Educational Notice: This scanner checks specific Windows configuration parameters and defensive controls.' }; $rep | ConvertTo-Json -Depth 5 | Set-Content -Path $env:USERPROFILE\Desktop\audit_report.json -Encoding utf8"

echo.
echo ====================================================
echo  [SUCCESS] Local PC Audit Complete!
echo  Audit Report file created at:
echo  %USERPROFILE%\Desktop\audit_report.json
echo ====================================================
echo.
echo You can now upload audit_report.json to the cloud dashboard:
echo https://cyber-sage-navy.vercel.app/
echo.
pause
